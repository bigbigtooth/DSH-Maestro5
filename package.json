{
  "name": "dsh-maestro5",
  "version": "1.0.0",
  "description": "DSH Maestro5：主控 + L1–L5 五档难度子智能体的团队模式，安装即得配置界面",
  "type": "module",
  "license": "MIT",
  "author": "bigbigtooth",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-preset",
    "subagent",
    "multi-agent",
    "team",
    "maestro"
  ],
  "homepage": "https://github.com/bigbigtooth/DSH-Maestro5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigbigtooth/DSH-Maestro5.git"
  },
  "bugs": {
    "url": "https://github.com/bigbigtooth/DSH-Maestro5/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "validate": "node scripts/validate.mjs"
  },
  "devDependencies": {
    "js-yaml": "^4.1.0"
  }
}
